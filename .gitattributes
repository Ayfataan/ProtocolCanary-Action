# Generated build artifacts (esbuild bundle — see CONTRIBUTING.md "Build").
# Never hand-edit these; regenerate with `npm run build`.
# linguist-generated collapses them in PR diffs and excludes them from
# language statistics; -diff keeps git from producing full un-collapsed
# diffs for these minified multi-MB files.
*.ts text eol=lf
*.tsx text eol=lf
tests/golden/*.md text eol=lf
dist/index.js text eol=lf linguist-generated=true -diff
dist/index.js.map text eol=lf linguist-generated=true -diff
